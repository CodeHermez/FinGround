{
  "Urls": "http://localhost:5050",
  "FinGroundApi": {
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 30
  },
  "McpServer": {
    "RequireAuth": true,
    "EnableMoneyMovement": true,
    "EnableLoginTool": true,
    "MaxTransactionAmount": 10000
  },
  "Jwt": {
    "Issuer": "FinGround",
    "Audience": "FinGroundClients"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
